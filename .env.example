# Copy to .env for local runs; on a cloud host set these as service env vars.

# --- Gmail SMTP ---------------------------------------------------------
# Use a 16-character App Password (Google account -> Security -> App passwords),
# never the normal account password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
RSVP_TO_EMAIL=you@gmail.com
FROM_NAME=Kishin & Jessica

# Optional SMTP overrides (defaults: smtp.gmail.com, port 465, secure)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=

# --- RSVP dashboard (/admin) -------------------------------------------
ADMIN_PASSWORD=choose-a-long-random-password
# Optional. Pins login cookies across restarts; derived automatically if blank.
ADMIN_SESSION_SECRET=

# --- Server -------------------------------------------------------------
PORT=3000
# Where rsvps.jsonl and invitations.json live (default: ./data).
# On a cloud host point this at the attached volume, e.g. /var/data
# DATA_DIR=/var/data
