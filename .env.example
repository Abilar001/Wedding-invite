# Copy to .env for local runs; on a cloud host set these as service env vars.

# --- Email (Brevo transactional API, HTTPS) ------------------------------
# 1. Create a free account at https://brevo.com (300 emails/day).
# 2. Verify your sender address under Senders, Domains and IPs — a Gmail
#    address is fine, no domain needed. Use that exact address below.
# 3. Create an API key under SMTP & API -> API Keys.
BREVO_API_KEY=xkeysib-your-api-key
RSVP_FROM_EMAIL=you@gmail.com
RSVP_TO_EMAIL=you@gmail.com
FROM_NAME=Kishin & Jessica

# --- RSVP dashboard (/admin) -------------------------------------------
ADMIN_PASSWORD=choose-a-long-random-password
# Optional. Pins login cookies across restarts; derived automatically if blank.
ADMIN_SESSION_SECRET=

# --- Server -------------------------------------------------------------
PORT=3000
# Where rsvps.jsonl and invitations.json live (default: ./data).
# Point this at a mounted volume on a host that provides one, e.g. /var/data
# DATA_DIR=/var/data
